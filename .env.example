DATABASE_URL="postgresql://postgres:postgres@localhost:5432/silent_witness_admin?schema=public"
REDIS_URL="redis://localhost:6379"

# S3-compatible storage (MinIO locally)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="silentwitness-admin"
S3_REGION="us-east-1"

# App auth
JWT_SECRET="change-me"
SESSION_COOKIE_NAME="sw_session"

# Encryption for secrets (replace with KMS/Vault in production)
ENCRYPTION_KEY_BASE64="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Silent Witness analysis API
SILENT_WITNESS_PUBLIC_BASE_URL="https://api.silentwitness.ai"
SILENT_WITNESS_STAGING_BASE_URL="https://core.staging.silentwitness.ai"

# Anthropic (Claude) — powers the Slack bot brain
ANTHROPIC_API_KEY="sk-ant-..."

# Gmail IMAP/SMTP — used for inbound email polling + response sending
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password for "Mail"
# 3. Paste it below (16 chars, no spaces)
GMAIL_USER="saif@silentwitness.ai"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
GMAIL_IMAP_HOST="imap.gmail.com"
GMAIL_IMAP_PORT="993"
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT="465"
GMAIL_POLL_INTERVAL_MS="15000"

# Initial seed admin user
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin-password"
